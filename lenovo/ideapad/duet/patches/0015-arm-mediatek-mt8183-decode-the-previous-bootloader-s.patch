diff --git a/arch/arm/mach-mediatek/mt8183/init.c b/arch/arm/mach-mediatek/mt8183/init.c
index 6cb7c742ee4..ac14b4b3272 100644
--- a/arch/arm/mach-mediatek/mt8183/init.c
+++ b/arch/arm/mach-mediatek/mt8183/init.c
@@ -5,8 +5,9 @@
  * Author: Fabien Parent <fparent@baylibre.com>
  */
 #include <clk.h>
-#include <dm.h>
+#include <string.h>
 #include <fdtdec.h>
+#include <init.h>
 #include <ram.h>
 #include <wdt.h>
 #include <asm/arch/misc.h>
@@ -16,12 +17,287 @@
 #include <asm/u-boot.h>
 #include <dm/uclass.h>
 #include <dt-bindings/clock/mt8516-clk.h>
+#include <linux/types.h>
+#include <asm/io.h>
+#include <cpu_func.h>
 
 DECLARE_GLOBAL_DATA_PTR;
 
+/*
+ * Print the decoded bank list.  dram_init() leaves gd->dram[] zeroed
+ * unless it decoded a shaped map from the previous bootloader, so the
+ * list ends at the first zero-size bank.
+ *
+ * This runs before relocation: .bss overlays .rela.dyn until the dynamic
+ * relocations have been applied (see u-boot.lds), so no file-scope
+ * variable may be written or relied upon here -- the decoded map lives
+ * in gd->dram[] only.
+ */
+static int dram_count_banks(void)
+{
+	int i;
+
+	for (i = 0; i < CONFIG_NR_DRAM_BANKS && gd->dram[i].size; i++)
+		;
+
+	return i;
+}
+
+static void dram_print_banks(void)
+{
+	int i;
+
+	for (i = 0; i < CONFIG_NR_DRAM_BANKS && gd->dram[i].size; i++) {
+		phys_addr_t end = gd->dram[i].start + gd->dram[i].size - 1;
+
+		printf("DRAM bank %d: %pap-%pap\n", i, &gd->dram[i].start,
+		       &end);
+	}
+}
+
+/*
+ * Coreboot table layout, see coreboot's
+ * src/commonlib/include/commonlib/coreboot_tables.h (lb_header /
+ * lb_memory_range; identical to U-Boot's arch/x86/include/asm/
+ * coreboot_tables.h) and depthcharge's payload entry ABI.
+ *
+ * U-Boot on kukui is booted by coreboot + depthcharge.  depthcharge's
+ * vboot kernel path hands the flattened handoff FDT in x0, with /memory
+ * rebuilt from the coreboot memory tables; the altfw payload path hands
+ * the coreboot tables themselves (coreboot's selfload() passes
+ * CBMEM_ID_CBTABLE as the payload entry argument and libpayload's
+ * head.S stores x0 in cb_header_ptr).  Both are preferred over the
+ * control FDT, which hardcodes the DRAM size of the board it was
+ * written for; of the two, the tables are the authoritative map and are
+ * tried first (see dram_init()).
+ */
+#define CB_TAG_MEMORY		0x0001
+#define CB_MEM_RAM		1
+
+struct cb_header {
+	u8 signature[4];
+	u32 header_bytes;
+	u32 header_checksum;
+	u32 table_bytes;
+	u32 table_checksum;
+	u32 table_entries;
+};
+
+struct cb_record {
+	u32 tag;
+	u32 size;
+};
+
+struct cbuint64 {
+	u32 lo;
+	u32 hi;
+};
+
+struct cb_memory_range {
+	struct cbuint64 start;
+	struct cbuint64 size;
+	u32 type;
+};
+
+struct cb_memory {
+	u32 tag;
+	u32 size;
+	struct cb_memory_range map[];
+};
+
+static int dram_from_coreboot(phys_addr_t cb_addr)
+{
+	const struct cb_header *hdr = (const void *)(uintptr_t)cb_addr;
+	const struct cb_record *rec;
+	const u8 *table_end;
+	phys_addr_t ram_start = 0;
+	phys_addr_t ram_end = 0;
+	phys_size_t total_size = 0;
+	bool have_ram = false;
+	bool truncated = false;
+	int nbanks = 0;
+	u32 i;
+
+	if (!cb_addr ||
+	    memcmp(hdr->signature, "LBIO", 4) ||
+	    hdr->header_bytes != sizeof(*hdr) ||
+	    hdr->table_entries > hdr->table_bytes / sizeof(*rec))
+		return -EINVAL;
+
+	rec = (const struct cb_record *)(hdr + 1);
+	table_end = (const u8 *)rec + hdr->table_bytes;
+	for (i = 0; i < hdr->table_entries; i++) {
+		if (rec->size < sizeof(*rec) ||
+		    (const u8 *)rec + rec->size > table_end)
+			break;
+
+		if (rec->tag == CB_TAG_MEMORY) {
+			const struct cb_memory *mem = (const void *)rec;
+			u32 nranges = (rec->size - sizeof(*mem)) /
+				      sizeof(struct cb_memory_range);
+			u32 j;
+
+			for (j = 0; j < nranges; j++) {
+				const struct cb_memory_range *range = &mem->map[j];
+				phys_addr_t start, end;
+
+				if (range->type != CB_MEM_RAM)
+					continue;
+
+				start = ((phys_addr_t)range->start.hi << 32) |
+					range->start.lo;
+				end = start + (((phys_addr_t)range->size.hi << 32) |
+					       range->size.lo);
+
+				if (end <= start)
+					continue;
+
+				if (nbanks < CONFIG_NR_DRAM_BANKS) {
+					gd->dram[nbanks].start = start;
+					gd->dram[nbanks].size = end - start;
+					nbanks++;
+				} else {
+					truncated = true;
+				}
+				total_size += end - start;
+
+				if (!have_ram || start < ram_start)
+					ram_start = start;
+				if (end > ram_end)
+					ram_end = end;
+				have_ram = true;
+			}
+		}
+
+		rec = (const struct cb_record *)((const u8 *)rec + rec->size);
+	}
+
+	if (!have_ram || ram_end <= ram_start)
+		return -ENODATA;
+
+	if (truncated)
+		printf("DRAM: coreboot map has more RAM ranges than the %d banks reported\n",
+		       CONFIG_NR_DRAM_BANKS);
+
+	gd->ram_base = ram_start;
+	gd->ram_size = total_size;
+
+	return 0;
+}
+
 int dram_init(void)
 {
-	return fdtdec_setup_mem_size_base();
+	phys_addr_t cb_addr;
+	phys_addr_t base;
+	phys_size_t size;
+
+	if (fdtdec_setup_mem_size_base())
+		return -EINVAL;
+
+	/*
+	 * Zero the bank list up front: gd->dram[] starts out as stale
+	 * stack contents, and dram_init_banksize() keys off bank 0 being
+	 * empty to decide whether to fall back to the single contiguous
+	 * bank.
+	 */
+	memset(gd->dram, 0, sizeof(gd->dram));
+
+	/*
+	 * The control FDT hardcodes the DRAM size of the board it was
+	 * written for; on kukui that is 2 GiB while krane ships 4 GiB
+	 * variants.  U-Boot on krane is booted by coreboot + depthcharge,
+	 * which own the real memory map: coreboot loaded BL31 and reserved
+	 * the SCP and CBMEM regions, and reports the shaped result in its
+	 * memory tables.  Decode the ranges, not just their total:
+	 * dram_init_banksize() publishes them to LMB and the EFI memory
+	 * map, and the OS must see the same holes the boot chain carved
+	 * out.  Flattening them back into usable RAM exposes the
+	 * firmware-owned regions, on krane the ARM Trusted Firmware TZRAM
+	 * at 0x54600000.
+	 */
+	if (!IS_ENABLED(CONFIG_SAVE_PREV_BL_FDT_ADDR))
+		return 0;
+
+	cb_addr = get_prev_bl_fdt_addr();
+
+	/*
+	 * depthcharge flattens the handoff FDT with caches on and jumps
+	 * with them off without cleaning it: the bytes are stranded in
+	 * dirty cache lines and DRAM at the FDT slot reads as zeros
+	 * (observed: x0 = 0x5f800000, fdt_check_header() = -FDT_ERR_BADMAGIC,
+	 * first bytes 00000000 00000000). Clean and invalidate the boot
+	 * CPU caches before decoding either source below.
+	 */
+	flush_dcache_all();
+
+	/*
+	 * The coreboot tables are the authoritative map -- depthcharge's
+	 * /memory is itself rebuilt from them -- and they are maintained
+	 * in DRAM long before the payload runs.  The altfw payload ABI
+	 * passes them in x0; the vboot kernel path passes a handoff FDT
+	 * instead, and the tables are then found at the fixed CBMEM
+	 * address.  Prefer them over the handoff FDT, whose /memory reg
+	 * reads back corrupt on the shipping depthcharge build (a
+	 * zero-size first range followed by nonsensical ones) even though
+	 * the FDT header validates.
+	 */
+	if (!dram_from_coreboot(cb_addr)) {
+		printf("DRAM: coreboot tables at %pap report %llu MiB of usable RAM in %d banks\n",
+		       &cb_addr, (unsigned long long)gd->ram_size >> 20,
+		       dram_count_banks());
+		dram_print_banks();
+
+		return 0;
+	}
+
+	if (!dram_from_coreboot(0xffed9000)) {
+		printf("DRAM: coreboot tables at 0xffed9000 report %llu MiB of usable RAM in %d banks\n",
+		       (unsigned long long)gd->ram_size >> 20,
+		       dram_count_banks());
+		dram_print_banks();
+
+		return 0;
+	}
+
+	/*
+	 * Last resort: a previous bootloader that implements the Linux
+	 * boot ABI and passes an FDT in x0. (failing quietly, not via
+	 * fdt_valid(), when x0 is not an FDT.)
+	 */
+	if (!fdt_check_header((const void *)(uintptr_t)cb_addr) &&
+	    !fdtdec_decode_ram_size((const void *)(uintptr_t)cb_addr,
+				    "/memory", -1, &base, &size, gd) &&
+	    size) {
+		printf("DRAM: previous bootloader FDT at %pap reports %llu MiB of usable RAM in %d banks\n",
+		       &cb_addr, (unsigned long long)size >> 20,
+		       dram_count_banks());
+		dram_print_banks();
+
+		gd->ram_base = base;
+		gd->ram_size = size;
+
+		return 0;
+	}
+
+	return 0;
+}
+
+int dram_init_banksize(void)
+{
+	/*
+	 * dram_init() already filled gd->dram[] with the shaped map the
+	 * previous bootloader published; keep it, so LMB and the EFI memory
+	 * map reproduce the same holes.  Without a decoded map (control FDT
+	 * only, or no previous bootloader) fall back to the default single
+	 * contiguous bank.
+	 */
+	if (gd->dram[0].size)
+		return 0;
+
+	gd->dram[0].start = gd->ram_base;
+	gd->dram[0].size = get_effective_memsize();
+
+	return 0;
 }
 
 void reset_cpu(void)
@@ -29,6 +305,21 @@ void reset_cpu(void)
 	psci_system_reset();
 }
 
+phys_addr_t board_get_usable_ram_top(phys_size_t total_size)
+{
+	/*
+	 * Keep U-Boot's own allocations inside the first 4 GiB: the msdc
+	 * DMA engine can only address 32 bits, so relocation, heap and
+	 * DMA bounce buffers must not move into the upper DRAM once the
+	 * real 4 GiB size is reported. The OS still receives the full
+	 * range through the EFI memory map.
+	 */
+	if (gd->ram_top > 0x100000000ULL)
+		return 0x100000000ULL;
+
+	return gd->ram_top;
+}
+
 #if !IS_ENABLED(CONFIG_VIDEO_MT8183_DISPLAY)
 /*
