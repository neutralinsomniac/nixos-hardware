 #include <fdtdec.h>
 #include <fdt_support.h>
 #include <fdt.h>
@@ -58,11 +59,17 @@ int save_prev_bl_data(void)
 	if (!is_addr_accessible((phys_addr_t)reg0))
 		return -ENODATA;
 
-	fdt_blob = (struct fdt_header *)reg0;
-	if (!fdt_valid(&fdt_blob)) {
-		pr_warn("%s: address 0x%lx is not a valid fdt\n", __func__, reg0);
+	/*
+	 * The address in x0 is only guaranteed to be an FDT when the previous
+	 * bootloader implements the Linux boot ABI. Coreboot passes its
+	 * coreboot tables to payloads (src/lib/selfboot.c:
+	 * prog_set_entry(payload, entry, cbmem_find(CBMEM_ID_CBTABLE))) and
